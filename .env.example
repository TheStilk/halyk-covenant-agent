# Team meta
TEAM_NAME=Сычуанский Соус
CONTACT_EMAIL=serkebaevmadiyar09@gmail.com, zhenis415@gmail.com

# ---------------------------------------------------------------------------
# Primary LLM — OpenAI-compatible endpoint. Battle model: DeepSeek V4 Flash.
#
# Option A — DeepSeek platform directly (fewer moving parts, no proxy):
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-v4-flash
#
# Option B — OpenRouter (fallback if a teammate has no direct DeepSeek key):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=deepseek/deepseek-v4-flash
#
# Swap providers by editing only these three lines — no code changes.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# Optional override for submission.json "model" field (defaults to LLM_MODEL)
MODEL_LABEL=deepseek-v4-flash

# LLM_TIMEOUT_SEC=60
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=4096
# DeepSeek accepts temperature=0.0 normally — leave this off. Only needed for
# a provider that 400s on non-default sampling params.
# LLM_SKIP_TEMPERATURE=false

# Optional second OpenAI-compatible model for PDF classify only
# CLASSIFY_API_KEY=
# CLASSIFY_BASE_URL=
# CLASSIFY_MODEL=

# Runtime
DATA_DIR=./agentic-bank-public
# Optional path overrides (default: files under DATA_DIR with CASE names)
# LEDGER_PATH=./agentic-bank-public/master_ledger_2025.csv
# TEMPLATE_PATH=./agentic-bank-public/submission_template.json
# DOCUMENTS_DIR=./agentic-bank-public/documents
DOC_CACHE_DIR=./doc_cache

# --- Hybrid policy (battle defaults) ---
# Det always runs first. LLM Formula Reader interprets text → code computes numbers.
CLASSIFY_USE_LLM=false
USE_LLM_FORMULA_READER=true
# false = cross-checker: LLM runs on every cell, not just unknown/low-conf
#         ones. Det stays authoritative on strong known-formula cells
#         (FORMULA_READER_PREFER_DET_ON_MISMATCH below still wins ties), so
#         this catches a confident regex misclassification that det itself
#         can't detect — worth ~36 extra calls per battle run. (RECOMMENDED)
# true  = helper: LLM only fires when det already flags unknown/low-conf.
#         Cheaper/faster but blind to confident-and-wrong det verdicts.
LLM_FORMULA_READER_ONLY_UNKNOWN=false
# On mismatch: prefer det when det is known; unknown det → LLM compute
FORMULA_READER_PREFER_DET_ON_MISMATCH=true
FORMULA_READER_MAX_TEXT_CHARS=2500
# Det-only: NO_LLM=1 ./scripts/battle_run.sh   (or leave LLM_API_KEY empty)
# Soft OOM guards for extract (defaults: 16 MiB text files, tables first 20 pages)
MAX_TEXT_FILE_MB=16
MAX_TABLE_PAGES=32
# Cap PDF text extract / OCR raster pages (huge prospectuses)
MAX_PDF_TEXT_PAGES=80
MAX_OCR_PAGES=24
CONFIDENCE_THRESHOLD=0.85
MAX_BORROWER_CONCURRENCY=6
# OCR languages (default eng+rus+kaz — all required by preflight)
# TESSERACT_LANGS=eng+rus+kaz
