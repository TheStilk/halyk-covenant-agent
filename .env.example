# Team meta
TEAM_NAME=Сычуанский Соус
CONTACT_EMAIL=serkebaevmadiyar09@gmail.com, zhenis415@gmail.com

# Provider-agnostic OpenAI-compatible LLM (change only these to switch vendor)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.5-max
# LLM_TIMEOUT_SEC=60
# LLM_MAX_RETRIES=2

# Backward-compatible aliases (optional if LLM_* set)
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=

# Optional Gemini Flash (doc classify only)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.0-flash

# submission.json model field
# MODEL_LABEL=qwen3.8-max + gemini-3.6-flash

# Runtime
DATA_DIR=./agentic-bank-public
DOC_CACHE_DIR=./doc_cache
CLASSIFY_USE_LLM=false
USE_LLM_FORMULA_READER=true
FORMULA_READER_PREFER_DET_ON_MISMATCH=true
CONFIDENCE_THRESHOLD=0.85
MAX_BORROWER_CONCURRENCY=6
