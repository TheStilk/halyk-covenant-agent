# Team meta
TEAM_NAME=Сычуанский Соус
CONTACT_EMAIL=serkebaevmadiyar09@gmail.com, zhenis415@gmail.com

# ---------------------------------------------------------------------------
# Primary LLM (OpenAI-compatible). Change these to switch model/provider.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional override for submission.json "model" field (defaults to LLM_MODEL)
# MODEL_LABEL=

# LLM_TIMEOUT_SEC=60
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=8192

# Optional second OpenAI-compatible model for PDF classify only
# CLASSIFY_API_KEY=
# CLASSIFY_BASE_URL=
# CLASSIFY_MODEL=

# Runtime
DATA_DIR=./agentic-bank-public
DOC_CACHE_DIR=./doc_cache
CLASSIFY_USE_LLM=false
USE_LLM_FORMULA_READER=true
# true = LLM only when det is unknown/low-conf (battle default; saves RPM)
LLM_FORMULA_READER_ONLY_UNKNOWN=true
# mismatch: prefer det when det is strong; unknown det → LLM compute
FORMULA_READER_PREFER_DET_ON_MISMATCH=true
FORMULA_READER_MAX_TEXT_CHARS=900
CONFIDENCE_THRESHOLD=0.85
MAX_BORROWER_CONCURRENCY=6
